\contentsline {figure}{\numberline {6.3}{\ignorespaces Step 1: Sample Insertion prompt, ensuring the operator has correctly placed the tray before proceeding.}}{30}{figure.caption.62}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Step 3: Real-time optoelectrical calibration feedback.}}{30}{figure.caption.63}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Step 4: Image capture sequence, communicating progress as multiple frames are acquired.}}{31}{figure.caption.64}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Step 5: The final Quality Report, using threshold-relative visualisations for immediate interpretability.}}{31}{figure.caption.65}%
