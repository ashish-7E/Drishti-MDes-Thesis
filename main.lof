\contentsline {figure}{\numberline {1.1}{\ignorespaces A typical 100-gram wheat grain sample spread on a sorting table.}}{1}{figure.caption.14}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces The twelve distinct grain and impurity categories identified during manual assessment.}}{2}{figure.caption.16}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Initial checks during periphery testing: (a) moisture measurement and (b) Hectolitre weight for variety verification.}}{8}{figure.caption.25}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Master sample collection from \textit {boris} at godown.}}{9}{figure.caption.28}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Final illumination configurations: (a)~BY yellow backlight for grain boundary segmentation, (b)~WB white top-light for general classification, and (c)~BR red backlight for multispectral defect classification.}}{12}{figure.caption.32}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Prototype~I: low-fidelity 3D-printed enclosure validating the dual-illumination hypothesis.}}{13}{figure.caption.34}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Prototype~II at industrial scale, showing the high-density occlusion problem that redirected the design brief.}}{14}{figure.caption.36}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces The 100-gram grain sample before and after a single solenoid actuation cycle, demonstrating the transition from dense occlusion to measurable grain isolation and orientation diversity.}}{17}{figure.caption.42}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Timing diagram for the staggered asynchronous solenoid pulse protocol. Each solenoid ($S_A$ through $S_D$) activates sequentially with a 50\,ms inter-solenoid delay and remains active for 500\,ms. The staggered pattern produces a travelling impulse wave, generating grain rotation and dispersion without interference between activations.}}{18}{figure.caption.45}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Physical assembly sequence of the final prototype. (a)~Custom PCB for solenoid pulse timing. (b--d)~Progressive chassis and electronics assembly. (e)~Completed device prepared for deployment.}}{20}{figure.caption.48}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces CAD exploded view of the Drishti device, showing the vertical component stack: optics module, electromagnetic actuation array, and control electronics within the aluminium chassis.}}{21}{figure.caption.49}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Drishti system architecture: the Raspberry Pi 5 edge node handles physical actuation and image capture; the central inference server handles segmentation and returns per-category $W/W\%$ results.}}{24}{figure.caption.55}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces The finalised Drishti device with the hole-fitting grain tray, positioned for sample loading.}}{28}{figure.caption.59}%
